graph Ciudad {
layout=neato;
label="CiudadPrueba2";
labelloc="t";
fontsize=20;
node [shape=square, fixedsize=true, width=0.9, label=""];

Col1 [pos="1,0!", shape=plaintext, label="1"];
Col2 [pos="2,0!", shape=plaintext, label="2"];
Col3 [pos="3,0!", shape=plaintext, label="3"];
Col4 [pos="4,0!", shape=plaintext, label="4"];
Col5 [pos="5,0!", shape=plaintext, label="5"];
Col6 [pos="6,0!", shape=plaintext, label="6"];
Fil1 [pos="0,-1!", shape=plaintext, label="1"];
Fil2 [pos="0,-2!", shape=plaintext, label="2"];
Fil3 [pos="0,-3!", shape=plaintext, label="3"];
Fil4 [pos="0,-4!", shape=plaintext, label="4"];
C1_1 [pos="1,-1!", style=filled, fillcolor="green"];
C1_2 [pos="2,-1!", style=filled, fillcolor="yellow"];
C1_3 [pos="3,-1!", style=filled, fillcolor="yellow"];
C1_4 [pos="4,-1!", style=filled, fillcolor="yellow"];
C1_5 [pos="5,-1!", style=filled, fillcolor="yellow"];
C1_6 [pos="6,-1!", style=filled, fillcolor="black"];
C2_1 [pos="1,-2!", style=filled, fillcolor="white"];
C2_2 [pos="2,-2!", style=filled, fillcolor="white"];
C2_3 [pos="3,-2!", style=filled, fillcolor="blue"];
C2_4 [pos="4,-2!", style=filled, fillcolor="white"];
C2_5 [pos="5,-2!", style=filled, fillcolor="yellow"];
C2_6 [pos="6,-2!", style=filled, fillcolor="yellow"];
C3_1 [pos="1,-3!", style=filled, fillcolor="white"];
C3_2 [pos="2,-3!", style=filled, fillcolor="yellow"];
C3_3 [pos="3,-3!", style=filled, fillcolor="yellow"];
C3_4 [pos="4,-3!", style=filled, fillcolor="yellow"];
C3_5 [pos="5,-3!", style=filled, fillcolor="gray"];
C3_6 [pos="6,-3!", style=filled, fillcolor="yellow"];
C4_1 [pos="1,-4!", style=filled, fillcolor="black"];
C4_2 [pos="2,-4!", style=filled, fillcolor="yellow"];
C4_3 [pos="3,-4!", style=filled, fillcolor="yellow"];
C4_4 [pos="4,-4!", style=filled, fillcolor="yellow"];
C4_5 [pos="5,-4!", style=filled, fillcolor="yellow"];
C4_6 [pos="6,-4!", style=filled, fillcolor="green"];
Ley1 [pos="1.3,-5!", style=filled, fillcolor="black", label=""];
LeyTexto1 [pos="3,-5!", shape=plaintext, label="Intransitable"];
Ley2 [pos="1.3,-6!", style=filled, fillcolor="green", label=""];
LeyTexto2 [pos="3,-6!", shape=plaintext, label="Entrada"];
Ley3 [pos="1.3,-7!", style=filled, fillcolor="white", label=""];
LeyTexto3 [pos="3,-7!", shape=plaintext, label="Transitable"];
Ley4 [pos="1.3,-8!", style=filled, fillcolor="red", label=""];
LeyTexto4 [pos="3,-8!", shape=plaintext, label="Unidad Militar"];
Ley5 [pos="1.3,-9!", style=filled, fillcolor="blue", label=""];
LeyTexto5 [pos="3,-9!", shape=plaintext, label="Unidad Civil"];
Ley6 [pos="1.3,-10!", style=filled, fillcolor="gray", label=""];
LeyTexto6 [pos="3,-10!", shape=plaintext, label="Unidad Recurso"];

Info [pos="1.5,-11.5!", shape=plaintext, label="Tipo de misión: Extraccion\nObjetivo: 3,5\nRobot utilizado: robot01 (ChapinFighter)\nCapacidad inicial: 150, Capacidad final: 150\n\n\n\n"];

C1_1 -- C1_2 [color=orange, penwidth=3];
C1_2 -- C1_3 [color=orange, penwidth=3];
C1_3 -- C1_4 [color=orange, penwidth=3];
C1_4 -- C1_5 [color=orange, penwidth=3];
C1_5 -- C2_5 [color=orange, penwidth=3];
C2_5 -- C2_6 [color=orange, penwidth=3];
C2_6 -- C3_6 [color=orange, penwidth=3];
C3_6 -- C4_6 [color=orange, penwidth=3];
C4_6 -- C4_5 [color=orange, penwidth=3];
C4_5 -- C4_4 [color=orange, penwidth=3];
C4_4 -- C4_3 [color=orange, penwidth=3];
C4_3 -- C4_2 [color=orange, penwidth=3];
C4_2 -- C3_2 [color=orange, penwidth=3];
C3_2 -- C3_3 [color=orange, penwidth=3];
C3_3 -- C3_4 [color=orange, penwidth=3];
C3_4 -- C3_5 [color=orange, penwidth=3];
}
